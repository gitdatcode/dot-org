---
import type { GhostPost } from '../lib/api/ghost'
import PostCard from './PostCard.astro'

interface Props {
  posts: GhostPost[]
  title?: string
}

const { posts, title = 'Latest Posts' } = Astro.props
---

<section class="w-full">
  <div class="w-full py-8">
    <h1 class="text-3xl font-bold mb-8 text-center text-foreground">{title}</h1>

    {
      posts.length === 0 && (
        <div class="text-center py-12 text-neutral-600">
          <p>No posts found</p>
        </div>
      )
    }

    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
    >
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </div>
</section>
