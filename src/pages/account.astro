---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Your Account">
  <main class="container mx-auto px-4 py-8">
    <div class="max-w-2xl mx-auto">
      <h1 class="text-3xl font-bold mb-8">Your Account</h1>

      <div id="account-loading" class="p-8 bg-white rounded-lg shadow-md">
        <div class="animate-pulse flex space-x-4">
          <div class="rounded-full bg-gray-200 h-12 w-12"></div>
          <div class="flex-1 space-y-4 py-1">
            <div class="h-4 bg-gray-200 rounded w-3/4"></div>
            <div class="space-y-2">
              <div class="h-4 bg-gray-200 rounded"></div>
              <div class="h-4 bg-gray-200 rounded w-5/6"></div>
            </div>
          </div>
        </div>
      </div>

      <div id="account-error" class="hidden p-8 bg-white rounded-lg shadow-md">
        <div class="text-center">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-12 w-12 mx-auto text-red-500 mb-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
            ></path>
          </svg>
          <h2 class="text-xl font-bold text-gray-800 mb-2">
            Authentication Error
          </h2>
          <p class="text-gray-600 mb-4">
            You need to be signed in to view this page.
          </p>
          <a
            href="/signin"
            class="inline-block bg-purple-600 hover:bg-purple-700 text-white font-bold py-2 px-4 rounded transition duration-300"
          >
            Sign In
          </a>
        </div>
      </div>

      <div id="account-content" class="hidden">
        <div class="bg-white rounded-lg shadow-md overflow-hidden mb-6">
          <div class="p-6">
            <div class="flex items-center mb-4">
              <div
                id="user-avatar"
                class="w-16 h-16 rounded-full bg-purple-100 flex items-center justify-center text-purple-600 text-2xl font-bold mr-4"
              >
                <!-- Avatar initial will be inserted here -->
              </div>
              <div>
                <h2 id="user-name" class="text-2xl font-bold text-gray-800">
                  <!-- User name will be inserted here -->
                </h2>
                <p id="user-email" class="text-gray-600">
                  <!-- User email will be inserted here -->
                </p>
              </div>
            </div>

            <div id="membership-status" class="mt-4 p-4 rounded-lg bg-gray-50">
              <!-- Membership status will be inserted here -->
            </div>
          </div>
        </div>

        <div class="bg-white rounded-lg shadow-md overflow-hidden mb-6">
          <div class="p-6">
            <h3 class="text-xl font-bold text-gray-800 mb-4">
              Account Actions
            </h3>
            <div class="space-y-3">
              <button
                id="sign-out-button"
                class="w-full text-left px-4 py-3 rounded-md bg-red-50 text-red-700 hover:bg-red-100 flex items-center"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5 mr-2"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
                  ></path>
                </svg>
                Sign Out
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  // Define member type
  interface Member {
    uuid?: string
    email: string
    name?: string
    paid?: boolean
  }

  // Elements
  const loadingEl = document.getElementById('account-loading')
  const errorEl = document.getElementById('account-error')
  const contentEl = document.getElementById('account-content')
  const userAvatarEl = document.getElementById('user-avatar')
  const userNameEl = document.getElementById('user-name')
  const userEmailEl = document.getElementById('user-email')
  const membershipStatusEl = document.getElementById('membership-status')
  const signOutButton = document.getElementById('sign-out-button')

  // Fetch current member
  async function fetchMember() {
    try {
      const response = await fetch('/api/ghost/member', {
        credentials: 'include'
      })

      if (!response.ok) {
        showError()
        return
      }

      const data = await response.json()

      if (data.success && data.member) {
        displayMember(data.member as Member)
      } else {
        showError()
      }
    } catch (error) {
      console.error('Failed to fetch member:', error)
      showError()
    } finally {
      if (loadingEl) loadingEl.style.display = 'none'
    }
  }

  // Display member information
  function displayMember(member: Member) {
    if (contentEl) contentEl.classList.remove('hidden')

    // Set avatar initial
    if (userAvatarEl) {
      const initial = member.name
        ? member.name.charAt(0).toUpperCase()
        : member.email.charAt(0).toUpperCase()
      userAvatarEl.textContent = initial
    }

    // Set name and email
    if (userNameEl) userNameEl.textContent = member.name || 'Member'
    if (userEmailEl) userEmailEl.textContent = member.email

    // Set membership status
    if (membershipStatusEl) {
      if (member.paid) {
        membershipStatusEl.innerHTML = `
          <div class="flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-green-500 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <div>
              <p class="font-medium text-gray-800">Paid Membership</p>
              <p class="text-sm text-gray-600">You have access to all premium content.</p>
            </div>
          </div>
        `
      } else {
        membershipStatusEl.innerHTML = `
          <div class="flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <div>
              <p class="font-medium text-gray-800">Free Membership</p>
              <p class="text-sm text-gray-600">You have access to free content only.</p>
              <a href="/pricing" class="text-sm text-purple-600 hover:text-purple-800 mt-1 inline-block">Upgrade to paid membership</a>
            </div>
          </div>
        `
      }
    }
  }

  // Show error state
  function showError() {
    if (loadingEl) loadingEl.style.display = 'none'
    if (errorEl) errorEl.classList.remove('hidden')
  }

  // Handle sign out
  if (signOutButton) {
    signOutButton.addEventListener('click', async () => {
      try {
        const response = await fetch('/api/ghost/member', {
          method: 'DELETE',
          credentials: 'include'
        })

        if (response.ok) {
          // Redirect to home page after sign out
          window.location.href = '/'
        } else {
          alert('Failed to sign out. Please try again.')
        }
      } catch (error) {
        console.error('Error signing out:', error)
        alert('An error occurred while signing out.')
      }
    })
  }

  // Initialize
  fetchMember()
</script>
