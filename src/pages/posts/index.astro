---
import PostList from '../../components/PostList.astro'
import SearchBar from '../../components/SearchBar.astro'
import { getPostsTextFormat } from '../../lib/api/ghost'
import Layout from '../../layouts/Layout.astro'

// Try to fetch posts
let posts: any[] = []
let apiError = false
const isDev = import.meta.env.DEV

// Debugging
try {
  posts = await getPostsTextFormat()
  // If posts is empty, it might indicate an API issue
  apiError = posts.length === 0 && isDev
} catch (error) {
  console.error('Failed to fetch posts:', error)
  apiError = true
}
---

<Layout title="DATCODE">
  <main class="container mx-auto px-4 py-8 max-w-7xl">
    <h1 class="text-4xl font-bold text-center mb-6 text-primary">DATCODE</h1>
    <p class="text-center text-neutral-600 mb-8 max-w-2xl mx-auto">
      Browse our latest content
    </p>

    <SearchBar />

    {
      isDev && apiError ? (
        <div class="bg-error/10 border border-error/20 text-error px-4 py-8 rounded-lg text-center my-12">
          <h2 class="text-2xl font-bold mb-4">Content Unavailable</h2>
          <p class="mb-2">
            We're unable to load content at this time. This could be due to
            missing API credentials or a connection issue.
          </p>
          <p class="text-sm text-error/80">
            Please check your Ghost API configuration in the environment
            variables.
          </p>
        </div>
      ) : (
        <PostList posts={posts} />
      )
    }
  </main>
</Layout>
