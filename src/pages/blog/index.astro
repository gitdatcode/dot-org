---
import { getPostsTextFormat } from '../../lib/api/ghost'
import Layout from '../../layouts/Layout.astro'

let posts: any[] = []

// Debugging
try {
  posts = await getPostsTextFormat()
  // If posts is empty, it might indicate an API issue
  // apiError = posts.length === 0 && isDev
} catch (error) {
  console.error('Failed to fetch posts:', error)
  // apiError = true
}

// console.log('posts[0]', posts[0])
const latestPost = posts[0]
const author = latestPost.authors[0]
function formattedDate(dateToFormat: Date) {
  const date = new Date(dateToFormat)
  return date.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  })
}

const archivePosts = posts.toSpliced(0, 1)
---

<Layout title="DATCODE">
  <main class="container py-8 min-h-[100dvh]">
    <h1 class="text-xl uppercase pb-[6%] font-serif">Latest Post</h1>
    <h2 class="text-3xl uppercase pb-[3%] font-display text-balance">
      {latestPost.title}
    </h2>
    <div class="flex gap-8 align-middle items-baseline">
      <span class="font-serif">by {author.name}</span>
      <span class="font-sans">{formattedDate(latestPost.published_at)}</span>
    </div>
    <p class="text-xs my-[6%] line-clamp-4 font-serif">{latestPost.excerpt}</p>
    <a href={`/blog/${latestPost.slug}`} class="group bg-[#3A4451] py-[0.375rem] px-4 rounded-[90px] max-w-fit">
      <span
        class="font-sans relative group-hover:after:content-[''] group-hover:after:absolute group-hover:after:bg-[#CEDDF1] group-hover:after:left-0 group-hover:after:right-0 group-hover:after:h-[2px] group-hover:after:bottom-[-0.6em] group-focus:after:content-[''] group-focus:after:absolute group-focus:after:bg-[#CEDDF1] group-focus:after:left-0 group-focus:after:right-0 group-focus:after:h-[2px] group-focus:after:bottom-[-0.6em] text-[0.9rem]"
        >read more</span
      >
    </a>

    <aside>
      <h3 class="pt-[14%] pb-[5%] text-xl uppercase font-display">Archive</h3>
      <div class="flex flex-col gap-3 ms-9">
        {
          archivePosts.map((post) => (
            <a href={`/blog/${post.slug}`} class="flex justify-between text-lg hover:text-white group">
              <span class="group-hover:underline group-hover:underline-offset-2 font-serif font-bold">{post.title}</span>
              <span class="group-hover:underline group-hover:underline-offset-2 font-sans">{post.authors[0].name}</span>
            </a>
          ))
        }
      </div>
    </aside>
  </main>
</Layout>
