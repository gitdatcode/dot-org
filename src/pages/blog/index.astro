---
import { getPostsTextFormat } from '../../lib/api/ghost'
import Layout from '../../layouts/Layout.astro'

let posts: any[] = []

// Debugging
try {
  posts = await getPostsTextFormat()
  // If posts is empty, it might indicate an API issue
  // apiError = posts.length === 0 && isDev
} catch (error) {
  console.error('Failed to fetch posts:', error)
  // apiError = true
}

console.log('posts[0]', posts[0])
const latestPost = posts[0]
const author = latestPost.authors[0]
function formattedDate(dateToFormat: Date) {
const date = new Date(dateToFormat)
 return date.toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric'
})
}

const archivePosts = posts.toSpliced(0, 1)
---

<Layout title="DATCODE">
  <main class="container py-8 min-h-[100dvh]">
    <h1>Latest Post</h1>
    <h2>{latestPost.title}</h2>
    <div class="flex gap-8">
      <span>by {author.name}</span>
      <span>{formattedDate(latestPost.published_at)}</span>
    </div>
    <p>{latestPost.excerpt}</p>
    <a href=`blog/${latestPost.slug}`>read more</a>
    <aside>
      <h3>Archive</h3>
      {archivePosts.map((post) => (
      <a href=`blog/${post.slug}` class="flex justify-between">
        <span>{post.title}</span>
        <span>{formattedDate(post.published_at)}</span>
      </a>
        ))}
    </aside>
  </main>
</Layout>
