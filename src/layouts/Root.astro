    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Join the Black Tech Strike Force Discord community—a space where Black and Brown technologists thrive and grow.">
    <title>
      {title}
    </title>
    <script defer src="https://api.pirsch.io/pa.js"
    id="pianjs"
    data-code="rD9GvvAD9GcV2Gt7FLMxghmmb7qKt7vz"></script>
  </head>
  <body>
    <slot />
  </body>
</html>